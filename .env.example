TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
# Identity used when PSTN hits /voice/inbound (must match registered Device identity)
DEFAULT_INBOUND_IDENTITY=agent-poc
PORT=3001
# Short TTL (e.g. 120) makes tokenWillExpire easier to demo
TOKEN_TTL_SECONDS=3600

# Public https URL (e.g. ngrok) so Twilio can hit AMD/status callbacks
PUBLIC_BASE_URL=
ENABLE_AMD=true

# Optional: TwiML app for PreflightTest (echo/Record bins). Falls back to TWILIO_TWIML_APP_SID.
TWILIO_PREFLIGHT_TWIML_APP_SID=
